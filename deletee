const express = require("express");
const fs = require("fs");
const path = require("path");

const app = express();
const dataFile = path.join(__dirname, "data.json");

app.delete("/todos/:id", (req, res) => {
  try {
    console.log("ID to delete:", req.params.id);

    const todos = JSON.parse(fs.readFileSync(dataFile, "utf8"));

    if (!Array.isArray(todos)) {
      throw new Error("data.json must contain an array");
    }

    console.log("Before delete:", todos);

    const index = todos.findIndex(
      todo => todo && String(todo.id) === req.params.id
    );

    if (index === -1) {
      console.log("Todo not found");

      return res.status(404).json({
        message: "Todo not found"
      });
    }

    const [deletedTodo] = todos.splice(index, 1);

    fs.writeFileSync(dataFile, JSON.stringify(todos, null, 2), "utf8");

    console.log("Deleted todo:", deletedTodo);
    console.log("After delete:", todos);
    console.log("data.json saved successfully");

    return res.status(200).json({
      message: "Todo deleted successfully",
      todo: deletedTodo
    });
  } catch (error) {
    console.error("Delete failed:", error.message);

    return res.status(500).json({
      message: "Could not read or update data.json"
    });
  }
});

app.listen(3000, () => {
  console.log("Server running on http://localhost:3000");
});
